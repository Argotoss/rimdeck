<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
    xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

    <!-- ===================================================== -->
    <!-- Package Configuration -->
    <!-- ===================================================== -->

    <Package Name="RimDeck" Language="1033" Version="$(PackageVersion)"
        Manufacturer="RimDeck Team" UpgradeCode="7f8be3b2-e25a-45bd-ac3e-45cb3ca01758"
        InstallerVersion="500" Compressed="yes">

        <!-- ===================================================== -->
        <!-- Upgrade and Error Handling -->
        <!-- ===================================================== -->

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed."
            AllowSameVersionUpgrades="yes" />
        <MediaTemplate EmbedCab="yes" />

        <!-- ===================================================== -->
        <!-- Properties and Configuration -->
        <!-- ===================================================== -->

        <!-- License file path for the installer UI -->
        <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

        <!-- Force complete reinstall like app is new - a=all files, e=even if not installed,
        c=recache source, m=missing files, u=user registry, s=shortcuts -->
        <Property Id="REINSTALLMODE" Value="aecmus" />

        <!-- ===================================================== -->
        <!-- Icons -->
        <!-- ===================================================== -->

        <Icon Id="AppIcon.ico" SourceFile="themes\default-icons\AppIcon.ico" />

        <!-- ===================================================== -->
        <!-- UI Configuration -->
        <!-- ===================================================== -->

        <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

        <!-- ===================================================== -->
        <!-- Custom Actions -->
        <!-- ===================================================== -->

        <!-- Automatically launch RimDeck after installation -->
        <Property Id="RIMDECKTARGET" Secure="yes" />
        <CustomAction Id="SetRimDeckTarget"
            Property="RIMDECKTARGET"
            Value="[INSTALLFOLDER]RimDeck.exe"
            Execute="immediate" />
        <CustomAction Id="LaunchRimDeckAfterInstall"
            Property="RIMDECKTARGET"
            ExeCommand=""
            Return="asyncNoWait"
            Execute="deferred"
            Impersonate="yes" />

        <!-- ===================================================== -->
        <!-- Installation Sequence -->
        <!-- ===================================================== -->

        <InstallExecuteSequence>
            <Custom Action="SetRimDeckTarget" After="InstallFiles"
                Condition="NOT Installed" />
            <Custom Action="LaunchRimDeckAfterInstall" After="SetRimDeckTarget"
                Condition="NOT REMOVE" />
        </InstallExecuteSequence>

        <!-- ===================================================== -->
        <!-- Directory Structure -->
        <!-- ===================================================== -->

        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="INSTALLFOLDER" Name="RimDeck" />
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="RimDeckProgramMenu" Name="RimDeck" />
        </StandardDirectory>

        <!-- ===================================================== -->
        <!-- Application Files -->
        <!-- ===================================================== -->

        <!-- Main application files component group -->
        <ComponentGroup Id="MainApplication" Directory="INSTALLFOLDER">
            <Files Include="$(BuildOutput)\**" />
        </ComponentGroup>

        <!-- ===================================================== -->
        <!-- Shortcuts and Start Menu -->
        <!-- ===================================================== -->

        <!-- Desktop Shortcut Component -->
        <ComponentGroup Id="DesktopShortcutComponent" Directory="DesktopFolder">
            <Component Id="DesktopShortcut" Guid="17E949BF-9301-4E81-A4F0-AA6278E790D5">
                <Shortcut Id="ApplicationDesktopShortcut" Name="RimDeck"
                    Target="[INSTALLFOLDER]RimDeck.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico" />
                <RegistryValue Root="HKCU" Key="Software\RimDeck" Name="DesktopShortcut"
                    Type="integer" Value="1" KeyPath="yes" />
                <!-- Remove shortcut on uninstall -->
                <RemoveFolder Id="RemoveDesktopShortcut" Directory="DesktopFolder" On="uninstall" />
            </Component>
        </ComponentGroup>

        <!-- Start Menu Shortcuts Component -->
        <ComponentGroup Id="StartMenuShortcutComponent" Directory="RimDeckProgramMenu">
            <Component Id="StartMenuShortcuts" Guid="93AAD6F2-3F95-4F94-9255-C98F252A3DA9">
                <Shortcut Id="StartMenuShortcut" Name="RimDeck"
                    Target="[INSTALLFOLDER]RimDeck.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon.ico" />
                <Shortcut Id="UninstallShortcut" Name="Uninstall RimDeck"
                    Target="[System64Folder]msiexec.exe"
                    Arguments="/x [ProductCode]"
                    Description="Uninstalls RimDeck" />
                <RegistryValue Root="HKCU" Key="Software\RimDeck" Name="StartMenuShortcut"
                    Type="integer" Value="1" KeyPath="yes" />
                <!-- Remove start menu folder on uninstall -->
                <RemoveFolder Id="RemoveStartMenuFolder" Directory="RimDeckProgramMenu"
                    On="uninstall" />
            </Component>
        </ComponentGroup>

        <!-- ===================================================== -->
        <!-- Features -->
        <!-- ===================================================== -->

        <Feature Id="MainFeature" Title="RimDeck" Level="1" ConfigurableDirectory="INSTALLFOLDER">
            <ComponentGroupRef Id="MainApplication" />
            <ComponentGroupRef Id="DesktopShortcutComponent" />
            <ComponentGroupRef Id="StartMenuShortcutComponent" />
        </Feature>

    </Package>

</Wix>